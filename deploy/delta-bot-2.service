   [Unit]
   Description=Delta breakout bot (paper)
   After=network-online.target
   Wants=network-online.target

   [Service]
   Type=simple
   User=ubuntu
   WorkingDirectory=/home/ubuntu/delta-bot-2
   ExecStart=/home/ubuntu/delta-bot-2/venv/bin/python /home/ubuntu/delta-bot-2/bot.py
   Restart=always
   RestartSec=10

   [Install]
   WantedBy=multi-user.target
