# binance-bot settings. Copy to .env and fill in. Values shown are the code defaults.
# Never commit .env (it is in .gitignore).

# ---- exchange / mode ----
# delta | binance  (this bot runs EXCHANGE=binance)
EXCHANGE=delta
# 1 = PAPER (no orders sent). 0 = live orders
DRY_RUN=1
# demo | prod   (only used when DRY_RUN=0)
BINANCE_ENV=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=
DELTA_ENV=testnet
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=
# must be YES for real money
CONFIRM_LIVE=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- account / sizing ----
USD_INR_RATE=85
START_CAPITAL_INR=50000
TRADING_CAPITAL_USD=0
RISK_PCT=1.0
LEVERAGE=20
MARGIN_PCT_OF_EQUITY=100
MARGIN_STOP_LOSS_PCT=30
BE_TRIGGER_R=1
TRAIL_START_R=3
FEE_PCT_PER_SIDE=0.05
MIN_STOP_PCT=0.25
MAX_STOP_PCT=3.0
STOP_BUFFER_TICKS=1
STOP_TRIGGER_METHOD=mark_price
DAILY_LOSS_LIMIT_PCT=50
MONTHLY_LOSS_LIMIT_PCT=0
MAX_TRADES_PER_DAY=0
MAX_TRADES_PER_MONTH=0

# ---- strategies on/off ----
ENABLE_SHORT=1
ENABLE_LONG=1
ENABLE_BREAKOUT=1
# defaults to ENABLE_BREAKOUT
ENABLE_BREAKDOWN=1
ENABLE_POC=0
# BOOK JUMP (bookjump.py): paper mode + EXCHANGE=binance only
ENABLE_BOOKJUMP=0

# ---- session ----
# 24h | us
SESSION=24h
SESSION_OPEN=09:30
ENTRY_CUTOFF=15:30
SESSION_CLOSE=16:00

# ---- RSI / breakout ----
RSI_LENGTH=14
RSI_LEVEL=70
RSI_LONG_LEVEL=30
EMA_LENGTH=5
CONSOL_CANDLES=4
RANGE_PCT=1.0
BREAKOUT_CHECK_MINUTE=12
MIN_MOVE_PCT=0.1

# ---- order-book filter ----
OB_FILTER=1
OB_DEPTH_PCT=0.5
OB_MIN_RATIO=1.5

# ---- POC RETURN ----
POC_AWAY_PCT=2.0
POC_AWAY_OTHER_PCT=5.0
# default: BTC ETH SOL XRP BNB DOGE ADA LTC AVAX LINK (USDT)
POC_MAJORS=
POC_VALID_HOURS=24
POC_ROWS=50
POC_POLL_SEC=5
POC_SKIP_US_SESSION=0
POC_MIN_STOP_PCT=0.25
POC_NEAR_PCT=0.15
POC_RETREAT_PCT=0.5
POC_ORDER_TIMEOUT_SEC=300

# ---- universe / misc ----
CONTRACT_TYPES=perpetual_futures
SYMBOL_ALLOW=
SYMBOL_EXCLUDE=
MIN_TURNOVER_USD=0
WORKERS=6
MANAGE_INTERVAL_SEC=15

# ---- BOOK JUMP (only read when ENABLE_BOOKJUMP=1) ----
# USDT, own paper book
BJ_START_BALANCE=100
BJ_MAX_SYMBOLS=20
# 24h quote volume
BJ_MIN_VOL_USDT=20000000
# tick size as % of price: lower bound
BJ_TICK_MIN_PCT=0.01
# upper bound
BJ_TICK_MAX_PCT=0.1
BJ_UNIVERSE_HOURS=6
# x the average top-10 level size (USDT)
BJ_WALL_MULT=5
BJ_WALL_MIN_USDT=25000
# and | or
BJ_WALL_RULE=and
BJ_PERSIST_SEC=3
# resting orders + open positions
BJ_MAX_OPEN=3
BJ_RISK_PCT=1
# notional cap = 3 x book balance
BJ_MAX_NOTIONAL_X=3
BJ_ORDER_TIMEOUT_SEC=60
# cancel when price is max(BJ_AWAY_PCT %, BJ_AWAY_TICKS ticks) away from the order
BJ_AWAY_PCT=0.5
BJ_AWAY_TICKS=10
# exit (before breakeven) if the wall falls below this % of its size at the fill
BJ_WALL_KEEP_PCT=50
# breakeven once >= BJ_BE_PCT % AND >= BJ_BE_TICKS ticks in profit
BJ_BE_PCT=0.15
BJ_BE_TICKS=5
# then trail max(BJ_TRAIL_PCT %, BJ_TRAIL_TICKS ticks) behind the best price since entry
BJ_TRAIL_PCT=0.3
BJ_TRAIL_TICKS=8
BJ_TIME_STOP_SEC=300
BJ_MAKER_PCT=0.02
BJ_TAKER_PCT=0.05
BJ_GST_PCT=18
# kill switch: loss in one IST day, % of the day's start balance
BJ_DAY_LOSS_PCT=3
BJ_MAX_LOSS_STREAK=5
BJ_PAUSE_HOURS=6
BJ_STALE_SEC=10
BJ_STALE_KILL_SEC=60
