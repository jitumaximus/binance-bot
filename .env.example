# binance-bot settings. Copy to .env and fill in. Values shown are the code defaults.
# Never commit .env (it is in .gitignore).

# ---- exchange / mode ----
# delta | binance  (this bot runs EXCHANGE=binance)
EXCHANGE=delta
# 1 = PAPER (no orders sent). 0 = live orders
DRY_RUN=1
# demo | prod   (only used when DRY_RUN=0)
BINANCE_ENV=demo
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=
DELTA_ENV=testnet
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=
# must be YES for real money
CONFIRM_LIVE=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- account / sizing ----
USD_INR_RATE=85
START_CAPITAL_INR=50000
TRADING_CAPITAL_USD=0
RISK_PCT=1.0
LEVERAGE=20
MARGIN_PCT_OF_EQUITY=100
MARGIN_STOP_LOSS_PCT=30
BE_TRIGGER_R=1
TRAIL_START_R=3
FEE_PCT_PER_SIDE=0.05
MIN_STOP_PCT=0.25
MAX_STOP_PCT=3.0
STOP_BUFFER_TICKS=1
STOP_TRIGGER_METHOD=mark_price
DAILY_LOSS_LIMIT_PCT=50
MONTHLY_LOSS_LIMIT_PCT=0
MAX_TRADES_PER_DAY=0
MAX_TRADES_PER_MONTH=0

# ---- strategies on/off ----
ENABLE_SHORT=1
ENABLE_LONG=1
ENABLE_BREAKOUT=1
# defaults to ENABLE_BREAKOUT
ENABLE_BREAKDOWN=1
ENABLE_POC=0
# 1H RSI LONG / 1H RSI SHORT (rsi1h.py): paper mode + EXCHANGE=binance only; settings below
RSI1H_ENABLED=1
# BOOK JUMP + BJ ABSORB (bookjump.py): retired 23 Nov 2026 (ENABLE_BOOKJUMP is no longer read)
BJ_ENABLED=0

# ---- session ----
# 24h | us
SESSION=24h
SESSION_OPEN=09:30
ENTRY_CUTOFF=15:30
SESSION_CLOSE=16:00

# ---- RSI / breakout ----
RSI_LENGTH=14
RSI_LEVEL=70
RSI_LONG_LEVEL=30
EMA_LENGTH=5
CONSOL_CANDLES=4
RANGE_PCT=1.0
BREAKOUT_CHECK_MINUTE=12
MIN_MOVE_PCT=0.1

# ---- order-book filter ----
OB_FILTER=1
OB_DEPTH_PCT=0.5
OB_MIN_RATIO=1.5

# ---- POC RETURN ----
POC_AWAY_PCT=2.0
POC_AWAY_OTHER_PCT=5.0
# default: BTC ETH SOL XRP BNB DOGE ADA LTC AVAX LINK (USDT)
POC_MAJORS=
POC_VALID_HOURS=24
POC_ROWS=50
POC_POLL_SEC=5
POC_SKIP_US_SESSION=0
POC_MIN_STOP_PCT=0.25
POC_NEAR_PCT=0.15
POC_RETREAT_PCT=0.5
POC_ORDER_TIMEOUT_SEC=300

# ---- universe / misc ----
CONTRACT_TYPES=perpetual_futures
SYMBOL_ALLOW=
SYMBOL_EXCLUDE=
MIN_TURNOVER_USD=0
WORKERS=6
MANAGE_INTERVAL_SEC=15

# ---- BOOK JUMP (only read when ENABLE_BOOKJUMP=1) ----
# USDT, own paper book
BJ_START_BALANCE=100
BJ_MAX_SYMBOLS=20
# 24h quote volume
BJ_MIN_VOL_USDT=20000000
# tick size as % of price: lower bound
BJ_TICK_MIN_PCT=0.01
# upper bound
BJ_TICK_MAX_PCT=0.1
BJ_UNIVERSE_HOURS=6
# x the average top-10 level size (USDT)
BJ_WALL_MULT=5
BJ_WALL_MIN_USDT=25000
# and | or
BJ_WALL_RULE=and
BJ_PERSIST_SEC=3
# resting orders + open positions
BJ_MAX_OPEN=3
BJ_RISK_PCT=1
# notional cap = 3 x book balance
BJ_MAX_NOTIONAL_X=3
BJ_ORDER_TIMEOUT_SEC=60
# cancel when price is max(BJ_AWAY_PCT %, BJ_AWAY_TICKS ticks) away from the order
BJ_AWAY_PCT=0.5
BJ_AWAY_TICKS=10
# shadow only (logged, no exit): the old wall exit fired below this % of the wall's size at the fill
BJ_WALL_KEEP_PCT=50
# hard stop max(BJ_STOP_PCT %, BJ_STOP_TICKS ticks) from entry, on trade prints; the same distance sizes the trade
BJ_STOP_PCT=0.4
BJ_STOP_TICKS=10
# breakeven once >= BJ_BE_PCT % AND >= BJ_BE_TICKS ticks in profit
BJ_BE_PCT=0.15
BJ_BE_TICKS=5
# then trail max(BJ_TRAIL_PCT %, BJ_TRAIL_TICKS ticks) behind the best price since entry
BJ_TRAIL_PCT=0.3
BJ_TRAIL_TICKS=8
BJ_TIME_STOP_SEC=300
BJ_MAKER_PCT=0.02
BJ_TAKER_PCT=0.05
BJ_GST_PCT=18
# pause only on a stale feed (no pause on losses since 23 Nov 2026): BJ_STALE_KILL_SEC without data -> pause
BJ_PAUSE_HOURS=6
BJ_STALE_SEC=10
BJ_STALE_KILL_SEC=60

# ---- BJ ABSORB (second paper book, same feed / coins / wall rule / exits as BOOK JUMP) ----
BJA_ENABLE=1
BJA_START_BALANCE=100
BJA_RISK_PCT=1
BJA_MAX_OPEN=3
# traded volume hitting the wall >= this % of its size at the first touch...
BJA_ABSORB_PCT=30
# ...within this many seconds of the first touch...
BJA_WINDOW_SEC=60
# ...while the wall stays >= this % of that size and no trade prints beyond it...
BJA_KEEP_PCT=50
# ...and still true this many seconds later -> post-only order 1 tick in front of the wall
BJA_CONFIRM_S=2
BJA_ORDER_TIMEOUT_SEC=10
BJA_AWAY_TICKS=3

# ---- 1H RSI LONG / 1H RSI SHORT (rsi1h.py) ----
RSI1H_START_BALANCE=100
# RSI1H_RISK_PCT is no longer used (26 Nov 2026, sizing v2). Fractions, not percent:
# MAX_IMPACT_PCT=0.0005
# MAX_OPEN_TRADES=3
# RSI1H_MAX_STOP_PCT=2   (percent; 1H RSI candle stop at most this far from the entry, was MAX_STOP_PCT 0.03)
# HARD_STOP_PCT=0.03
# RSI1H_MMR=0.01
RSI1H_LEVERAGE=20
# closed 1H RSI(14) above / below arms SHORT / LONG (re-checked every hour)
RSI1H_OVERBOUGHT=70
RSI1H_OVERSOLD=30
RSI1H_SHORT_WINDOW_MIN=45
RSI1H_LONG_WINDOW_MIN=120
RSI1H_MIN_GAP=2
RSI1H_MIN_RSI_DIFF=3
RSI1H_MIN_STOP_PCT=0.5
RSI1H_COOLDOWN_MIN=30
RSI1H_MIN_VOL_USDT=500000
# paper slippage against us on entry and exit, % of price (0 = none, like the POC paper fills)
RSI1H_SLIPPAGE_PCT=0
RSI1H_BE_R=1
RSI1H_TRAIL_START_R=3
RSI1H_CHECK_DELAY_SEC=8
# 28 Nov 2026: skip a 1H RSI signal when the latest closed 1H RSI is too extreme (long below / short above)
RSI1H_EXTREME_LONG=10
RSI1H_EXTREME_SHORT=90
# 28 Nov 2026: skip when the entry is more than this % above the divergence candle's low (long) / below its high (short)
RSI1H_MAX_FROM_EXTREME_PCT=1
# 28 Nov 2026, no late entries: 1H RSI and EMA20 enter only within this fraction of their level (the divergence
# candle's close / the trigger), measured from the level; 4H RETRACE uses RETRACE_ENTRY_CAP_PCT (0.001) both sides
# ENTRY_LEVEL_CAP_PCT=0.001
# several divergences at one check: volume = highest 24h quote volume first (default), rsi = most extreme 1H RSI first
RSI1H_RANK_BY=volume

# Entry execution (25 Nov 2026, every book except POC RETURN): capped IOC limit children instead of a market order
# (paper: simulated on the live /fapi/v1/depth). Cap = best ask/bid at the signal +/- ENTRY_SLIP_CAP_PCT (0.001 = 0.1%);
# size at most LIQ_CAP_PCT_OF_DEPTH of the top-5 levels on our side; ENTRY_MAX_CHILDREN = safety limit per attempt.
ENTRY_SLIP_CAP_PCT=0.001
LIQ_CAP_PCT_OF_DEPTH=0.30
ENTRY_MAX_CHILDREN=20
# Limit exits (1H RSI books, paper): a TRAIL_STOP whose market exit would slip more than EXIT_SLIP_CAP_PCT exits with limit
# children down to the trail stop - that %; the rest waits there and goes at market at entry + EXIT_GUARD_R x R.
EXIT_SLIP_CAP_PCT=0.001
EXIT_GUARD_R=0.5
EXIT_MAX_CHILDREN=20
